<?xml version='1.0' ?>
<launch>
  <arg name="rviz" default="false"/>

  <let name="urdf_file" value="$(find-pkg-share sharmech_description)/urdf/sharmech.urdf.xacro"/>
  <let name="config"    value="$(find-pkg-share sharmech_bringup)/config/config.yaml"/>

  <!-- robot_state_publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_file)')"/>
  </node>

  <!-- core nodes (component container: 全ノードを同一プロセスで実行) -->
  <node_container pkg="rclcpp_components" exec="component_container"
                  name="sharmech_container" namespace="" output="screen">
    <composable_node pkg="sharmech_core" plugin="sharmech_core::KinematicsNode"
                     name="kinematics_node">
      <param from="$(var config)"/>
    </composable_node>
    <composable_node pkg="sharmech_core" plugin="sharmech_core::ArmControllerNode"
                     name="arm_controller_node">
      <param from="$(var config)"/>
    </composable_node>
    <composable_node pkg="sharmech_core" plugin="sharmech_core::GripperNode"
                     name="gripper_node">
      <param from="$(var config)"/>
    </composable_node>
    <composable_node pkg="sharmech_core" plugin="sharmech_core::TaskManagerNode"
                     name="task_manager_node">
      <param from="$(var config)"/>
    </composable_node>
  </node_container>

  <!-- rviz2 -->
  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen">
      <param name="config_file"
             value="$(find-pkg-share sharmech_description)/rviz/sharmech.rviz"/>
    </node>
  </group>
</launch>
