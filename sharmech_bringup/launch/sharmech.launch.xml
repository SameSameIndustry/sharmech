<?xml version='1.0' ?>
<launch>
  <arg name="rviz" default="false"/>
  <arg name="joy"  default="true"/>
  <!-- シミュレータ (catchrobo_sim_threejs) が /catchrobo/arm/current_pose を
       publish する場合は false にする。実機と二重publishすると衝突するため -->
  <arg name="hardware_bridge" default="true"/>
  <!-- 疑似MCU (sharmech_core/scripts/mock_mcu.py) に繋ぐ。true にすると
       hardware_bridge_node の mcu_ip/mcu_port を config/mock_mcu.yaml
       (127.0.0.1:8888) で上書きする。実機の IP は config.yaml が唯一の正本で、
       launch 引数では持たない (二重管理を避ける)。Humble の launch_xml では
       <param> に if/unless が使えないため、上書き用 yaml を <let> で切り替える -->
  <arg name="mock_mcu" default="false"/>
  <!-- 疑似MCU を 2 つ (r/z 基板役 :8888 と θ 基板役 :8890) 立てて 2 枚構成の
       フィードバック合成を確認する。config/mock_mcu_two_boards.yaml で上書きする
       (mock_mcu:=true は不要。こちらが優先される) -->
  <arg name="mock_mcu_two_boards" default="false"/>
  <!-- パターンB (ROS2側IK)。kinematics_node のリンク長等 (robot_geometry.yaml の
       kinematics セクション) は CAD/実測が無いため仮値 (0.0) のまま。
       実測するまで既定で無効にしておく -->
  <arg name="pattern_b" default="false"/>
  <!-- シューティングボックスのスロット座標は赤/青で異なる (robot_geometry.yaml の
       shooting_box.center_*_red / _blue)。デフォルト値を置かず、起動のたびに
       明示指定を必須にする (独断で選ばせない) -->
  <arg name="field_color"/>

  <let name="urdf_file" value="$(find-pkg-share sharmech_description)/urdf/sharmech.urdf.xacro"/>
  <let name="config"    value="$(find-pkg-share sharmech_bringup)/config/config.yaml"/>
  <!-- 物理パラメータ (作業領域・箱・リンク長・原点補正など)。正本は
       sharmech/params/robot_geometry.yaml で、このファイルは
       `python3 sharmech/params/generate.py` の生成物。config.yaml の後に読み込み、
       同名パラメータを上書きする。無ければ launch は失敗する (黙って C++ の
       既定値で動くことはない)。手順は sharmech/docs/parameter_tuning.md -->
  <let name="geometry"  value="$(find-pkg-share sharmech_bringup)/config/robot_geometry.generated.yaml"/>
  <!-- mock_mcu:=false のときは config.yaml をもう一度読むだけ (上書き無し) -->
  <let name="bridge_override"
       value="$(find-pkg-share sharmech_bringup)/config/mock_mcu.yaml" if="$(var mock_mcu)"/>
  <let name="bridge_override" value="$(var config)" unless="$(var mock_mcu)"/>
  <let name="bridge_override"
       value="$(find-pkg-share sharmech_bringup)/config/mock_mcu_two_boards.yaml"
       if="$(var mock_mcu_two_boards)"/>

  <!-- robot_state_publisher (/joint_states は hardware_bridge_node が publish する。
       hardware_bridge:=false 時は publish 元が無いため robot_state_publisher は
       起動時姿勢のまま更新されない。current_pose の可視化はシミュレータのHUD/3D表示を見ること) -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <!-- type="str" が無いと URDF が YAML として解釈されて起動に失敗する -->
    <param name="robot_description" value="$(command 'xacro $(var urdf_file)')" type="str"/>
  </node>

  <!-- PS4 コントローラのドライバ。joy_teleop_node は状態変化時のみの publish を
       前提に自前タイマーで送信するため autorepeat は不要 -->
  <node pkg="joy" exec="joy_node" name="joy_node" if="$(var joy)"/>

  <!-- sharmech_container: 全ノードを同一プロセスで実行 -->
  <node_container pkg="rclcpp_components" exec="component_container"
                  name="sharmech_container" namespace="" output="screen">

    <composable_node pkg="sharmech_core" plugin="sharmech_core::MotionGeneratorNode"
                     name="motion_generator_node">
      <param from="$(var config)"/>
      <param from="$(var geometry)"/>
    </composable_node>

    <composable_node pkg="sharmech_core" plugin="sharmech_core::JoyTeleopNode"
                     name="joy_teleop_node">
      <param from="$(var config)"/>
    </composable_node>

    <composable_node pkg="sharmech_core" plugin="sharmech_core::HardwareBridgeNode"
                     name="hardware_bridge_node" if="$(var hardware_bridge)">
      <param from="$(var config)"/>
      <param from="$(var bridge_override)"/>
    </composable_node>

    <composable_node pkg="sharmech_core" plugin="sharmech_core::KinematicsNode"
                     name="kinematics_node" if="$(var pattern_b)">
      <param from="$(var config)"/>
      <param from="$(var geometry)"/>
    </composable_node>

    <composable_node pkg="sharmech_core" plugin="sharmech_core::GameStateManagerNode"
                     name="game_state_manager_node">
      <param from="$(var config)"/>
      <param from="$(var geometry)"/>
      <param name="field_color" value="$(var field_color)"/>
    </composable_node>

  </node_container>

  <!-- rviz2 -->
  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen">
      <param name="config_file"
             value="$(find-pkg-share sharmech_description)/rviz/sharmech.rviz"/>
    </node>
  </group>
</launch>
