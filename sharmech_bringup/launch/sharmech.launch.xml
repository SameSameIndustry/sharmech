<?xml version='1.0' ?>
<launch>
  <arg name="rviz" default="false"/>
  <arg name="joy"  default="true"/>
  <!-- シミュレータ (catchrobo_sim_threejs) が /catchrobo/arm/current_pose を
       publish する場合は false にする。実機と二重publishすると衝突するため -->
  <arg name="hardware_bridge" default="true"/>

  <let name="urdf_file" value="$(find-pkg-share sharmech_description)/urdf/sharmech.urdf.xacro"/>
  <let name="config"    value="$(find-pkg-share sharmech_bringup)/config/config.yaml"/>

  <!-- robot_state_publisher (/joint_states は hardware_bridge_node が publish する。
       hardware_bridge:=false 時は publish 元が無いため robot_state_publisher は
       起動時姿勢のまま更新されない。current_pose の可視化はシミュレータのHUD/3D表示を見ること) -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <!-- type="str" が無いと URDF が YAML として解釈されて起動に失敗する -->
    <param name="robot_description" value="$(command 'xacro $(var urdf_file)')" type="str"/>
  </node>

  <!-- PS4 コントローラのドライバ。joy_teleop_node は状態変化時のみの publish を
       前提に自前タイマーで送信するため autorepeat は不要 -->
  <node pkg="joy" exec="joy_node" name="joy_node" if="$(var joy)"/>

  <!-- sharmech_container: 全ノードを同一プロセスで実行 -->
  <node_container pkg="rclcpp_components" exec="component_container"
                  name="sharmech_container" namespace="" output="screen">

    <composable_node pkg="sharmech_core" plugin="sharmech_core::MotionGeneratorNode"
                     name="motion_generator_node">
      <param from="$(var config)"/>
    </composable_node>

    <composable_node pkg="sharmech_core" plugin="sharmech_core::JoyTeleopNode"
                     name="joy_teleop_node">
      <param from="$(var config)"/>
    </composable_node>

    <composable_node pkg="sharmech_core" plugin="sharmech_core::HardwareBridgeNode"
                     name="hardware_bridge_node" if="$(var hardware_bridge)">
      <param from="$(var config)"/>
    </composable_node>

    <!-- kinematics_node (パターンB) はロボット仕様確定後に追加する -->

  </node_container>

  <!-- rviz2 -->
  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen">
      <param name="config_file"
             value="$(find-pkg-share sharmech_description)/rviz/sharmech.rviz"/>
    </node>
  </group>
</launch>
