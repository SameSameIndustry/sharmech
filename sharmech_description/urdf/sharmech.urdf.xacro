<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sharmech">

  <!-- ===== 機構パラメータ ===== -->
  <xacro:property name="l1"          value="0.15"/>  <!-- 第1リンク長 [m] -->
  <xacro:property name="l2"          value="0.15"/>  <!-- 第2リンク長 [m] -->
  <xacro:property name="base_width"  value="0.10"/>  <!-- モータ間距離 [m] -->
  <xacro:property name="link_radius" value="0.008"/> <!-- リンク表示用半径 -->

  <!-- ===== マテリアル ===== -->
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>

  <!-- ===== ベースリンク ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_width + 0.02} 0.04 0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_width + 0.02} 0.04 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== モータ1 (左) ===== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child  link="upper_arm_left"/>
    <origin xyz="${-base_width/2} 0 0.01" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-1.5708" upper="3.1416" effort="10.0" velocity="3.1416"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="upper_arm_left">
    <visual>
      <origin xyz="${l1/2} 0 0"/>
      <geometry>
        <cylinder length="${l1}" radius="${link_radius}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- 左肘 (受動関節: 実機では5節リンク拘束により決まる) -->
  <joint name="elbow_left" type="continuous">
    <parent link="upper_arm_left"/>
    <child  link="forearm_left"/>
    <origin xyz="${l1} 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>

  <link name="forearm_left">
    <visual>
      <origin xyz="${l2/2} 0 0"/>
      <geometry>
        <cylinder length="${l2}" radius="${link_radius}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== モータ2 (右) ===== -->
  <joint name="joint2" type="revolute">
    <parent link="base_link"/>
    <child  link="upper_arm_right"/>
    <origin xyz="${base_width/2} 0 0.01" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit  lower="-3.1416" upper="1.5708" effort="10.0" velocity="3.1416"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="upper_arm_right">
    <visual>
      <origin xyz="${l1/2} 0 0"/>
      <geometry>
        <cylinder length="${l1}" radius="${link_radius}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="elbow_right" type="continuous">
    <parent link="upper_arm_right"/>
    <child  link="forearm_right"/>
    <origin xyz="${l1} 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>

  <link name="forearm_right">
    <visual>
      <origin xyz="${l2/2} 0 0"/>
      <geometry>
        <cylinder length="${l2}" radius="${link_radius}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== エンドエフェクタ ===== -->
  <!-- URDF は開ループツリー構造のため、5節リンクの閉ループ拘束は表現できない -->
  <!-- 実際のEE位置は kinematics_node が計算する -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="forearm_left"/>
    <child  link="end_effector"/>
    <origin xyz="${l2} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
